configure \
 primitive rsc_oracle_ora1 ocf:heartbeat:oracle \
 params sid="ora1" home="/opt/oracle/product/11gR2/db/" user="oracle" shutdown_method="immediate" ipcrm="orauser" \
 op start interval="0" timeout="240" \
 op stop interval="0" timeout="1800" on-fail="fence" \
 op monitor interval="30" timeout="130" start-delay="10" \
 meta target-role=stopped

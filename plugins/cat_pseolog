#!/bin/bash
# /usr/lib/supportconfig/plugins/cat_psauxlog
# Version: 2026-10-21

PLUG="cat_pseolog"
CONF="/etc/ClusterTools2/supportconfig_plugins"
LOGF="/var/log/pseo.log"
ZLOG="/var/log/pseo.log*bz2"

grep "^${PLUG}$" $CONF >/dev/null || exit 0 

echo "### $LOGF ###"
test -r $LOGF && cat $LOGF
for f in $ZLOG; do
	echo "### $f ###"
	test -r "$f" && bzcat "$f"
done
echo "Completed"
#

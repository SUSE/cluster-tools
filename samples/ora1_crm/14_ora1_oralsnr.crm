configure \
 primitive rsc_oralsnr_ora1 ocf:heartbeat:oralsnr \
 params sid="ora1" user="oracle" listener="listener" home="/opt/oracle/product/11gR2/db/" \
 op start interval="0" timeout="130" \
 op stop interval="0" timeout="130" on-fail="fence" \
 op monitor interval="30" timeout="130" start-delay="10" \
 meta target-role=stopped
